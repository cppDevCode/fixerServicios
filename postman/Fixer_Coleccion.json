      "name": "prestadores (alumno 1)",
      "description": "Endpoints del Módulo 1: Prestadores y Categorías (Integrante 1: Alejandro Lucas Baldres). Soporta listado paginado, búsqueda normalizada sin tildes, filtros por rubro/provincia/localidad, ordenamiento dinámico y CRUD completo con control de acceso por rol.",
      "item": [
        {
          "name": "GET Listar Prestadores (Paginado y Filtros)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Estructura RespuestaApi con datos y meta de paginación', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.codigo).to.eql(200);",
                  "    pm.expect(jsonData.datos).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.include.all.keys('pagina', 'limit', 'total', 'totalPages');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/prestadores?page=1&limit=10&rubro=Plomería&localidad=Córdoba Capital&search=Carlos&sortBy=nombre&order=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prestadores"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página (por defecto 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Cantidad de registros por página (por defecto 10)"
                },
                {
                  "key": "rubro",
                  "value": "Plomería",
                  "description": "Filtro por rubro/categoría profesional (insensible a mayúsculas y tildes)"
                },
                {
                  "key": "localidad",
                  "value": "Córdoba Capital",
                  "description": "Filtro por localidad del profesional"
                },
                {
                  "key": "search",
                  "value": "Carlos",
                  "description": "Búsqueda por texto en nombre, apellido, descripción (acercaDe) o rubro"
                },
                {
                  "key": "sortBy",
                  "value": "nombre",
                  "description": "Campo de ordenamiento (nombre, apellido, aniosExperiencia, ratingPromedio)"
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Dirección de ordenamiento (asc | desc)"
                }
              ]
            },
            "description": "Obtiene el listado paginado de prestadores aplicando filtros combinables por rubro, localidad, provincia, búsqueda libre y ordenamiento."
          },
